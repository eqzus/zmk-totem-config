//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
//
// BASE = QWERTY.  Tomma rutor i diagrammen = &trans / &none.
//
// ╔══════════════════════════════════════════════════════════════════════╗
// ║  VARIANT: kräver macOS-inmatningskällan "Svensk – Pro".               ║
// ║  Fungerar INTE med US-layout — då kommer fel tecken överallt.         ║
// ╚══════════════════════════════════════════════════════════════════════╝
//
// ZMK skickar scancodes; OS:et bestämmer tecknet. Med svensk layout ger
// samma scancode ett annat tecken än med US, så alla skiljetecken nedan är
// omskrivna. Bokstäver, F-tangenter, piltangenter, numeriska tangentbordet
// (KP_*) och alla Cmd-genvägar påverkas inte alls — därför är ADJ, TVP 1,
// TVP 2 och skärmklippslagret identiska med US-versionen.
//
// Vinsten: å ä ö är riktiga enkeltryck. Inga dödtangenter, inga makron,
// ingen mod-morph — shift ger Å Ä Ö av sig självt, och det fungerar även i
// terminaler, lösenordsfält och appar som läser råa tangenthändelser.
//
// Priset: ^ och ` är dödtangenter på svensk layout och behöver ett
// efterföljande mellanslag. De två är därför makron här. Samma sak gäller
// ~ om du vill lägga till det: <&kp RA(RBKT) &kp SPACE>.
//
// Teckentabell (macOS Svensk – Pro), för framtida redigering:
//
//   !  LS(N1)        "  LS(N2)        #  LS(N3)        €  LS(N4)
//   %  LS(N5)        &  LS(N6)        /  LS(N7)        (  LS(N8)
//   )  LS(N9)        =  LS(N0)        +  MINUS         ?  LS(MINUS)
//   å  LBKT          ¨  RBKT          ö  SEMI          ä  SQT
//   '  BSLH          *  LS(BSLH)      ,  COMMA         ;  LS(COMMA)
//   .  DOT           :  LS(DOT)       -  FSLH          _  LS(FSLH)
//   <  NON_US_BSLH   >  LS(NON_US_BSLH)
//   @  RA(N2)        £  RA(N3)        $  RA(N4)        |  RA(N7)
//   [  RA(N8)        ]  RA(N9)        \  LS(RA(N7))    {  LS(RA(N8))
//   }  LS(RA(N9))
//   Dödtangenter (kräver mellanslag efter): ´ EQUAL   ` LS(EQUAL)
//                                           ¨ RBKT    ^ LS(RBKT)   ~ RA(RBKT)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define TVP1 4
#define TVP2 5

// Timing för alla mod-taps (home row mods).
//
//   flavor "tap-preferred"     holdet kan bara lösas ut av att tangenten hålls
//                              längre än tapping-term, aldrig av att en annan
//                              tangent trycks. Snällast mot samma-hand-genvägar
//                              som Cmd+C och Cmd+V.
//   tapping-term-ms 230        oförändrat.
//   quick-tap-ms 175           tryck om samma tangent inom 175 ms => alltid tap
//                              (ger hold-to-repeat).
//   require-prior-idle-ms 150  en mod kan aldrig trigga inom 150 ms efter en
//                              annan tangent, dvs aldrig mitt i ett ord.
//
// require-prior-idle-ms ersätter den deprecated `global-quick-tap` (ZMK PR
// #1387, okt 2023). Den gamla hade inget eget värde utan återanvände
// quick-tap-ms — därför satt de två ihop förut. Sätt aldrig båda.

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <230>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Enda vägen till ESC sedan höger tumme blev ren lagertangent.
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        Macro {
            bindings = <&sl 6>;
            key-positions = <29 28>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(N7) &kp G &kp I &kp P &kp H &kp Y>;
        };

        // ^ och ` är dödtangenter på svensk layout: glyfen kommer först när
        // nästa tangent trycks. Mellanslaget efter ger det rena tecknet.

        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(RBKT) &kp SPACE>;

            label = "CARET";
        };

        btick: btick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp LS(EQUAL) &kp SPACE>;

            label = "BACKTICK";
        };
    };

    // Inget behaviors-block behövs: å ä ö är vanliga tangenter på svensk
    // layout, och shift fungerar på dem som på vilken bokstav som helst.
    // Varken mod-morph eller umlaut-makron finns kvar.

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     E     ┃     R     ┃     T     ┃   ┃     Y     ┃     U     ┃     I     ┃     O     ┃     P     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   GUI A   ┃   ALT S   ┃   CTL D   ┃   SFT F   ┃     G     ┃   ┃     H     ┃   SFT J   ┃   CTL K   ┃   ALT L   ┃   GUI ;   ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    BSPC   ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     N     ┃     M     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃  NAV TAB  ┃    SPC    ┃   ┃   ENTER   ┃    SYM    ┃    BSPC   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
               &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y    &kp U        &kp I        &kp O       &kp P
               &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G        &kp H    &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt RGUI LS(COMMA)
&kp BACKSPACE  &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N    &kp M        &kp COMMA    &kp DOT     &kp LS(N7)  &kp LS(RA(N7))
                                       &kp DEL      &lt NAV TAB  &kp SPACE    &kp RET  &mo SYM      &kp BSPC
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃    ESC    ┃    GIF    ┃     UP    ┃     =     ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃    LEFT   ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃    DEL    ┃    P UP   ┃   C LOCK  ┃   P DOWN  ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃     _     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃    ADJ    ┃     0     ┃     0     ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp ESC    &gif       &kp UP    &kp LS(N0)     &kp LS(RA(N8))    &kp LS(RA(N9))  &kp KP_N7  &kp KP_N8        &kp KP_N9  &kp KP_PLUS
        &kp LSHFT  &kp LEFT   &kp DOWN  &kp RIGHT      &kp RA(N8)        &kp RA(N9)      &kp KP_N4  &kp KP_N5        &kp KP_N6  &kp KP_MINUS
&trans  &kp DEL    &kp PG_UP  &kp CAPS  &kp PG_DN      &kp LS(N8)        &kp LS(N9)      &kp KP_N1  &kp KP_N2        &kp KP_N3  &kp KP_MULTIPLY  &kp LS(FSLH)
                              &trans    &trans     &trans      &mo ADJ   &kp KP_N0  &kp KP_NUMBER_0
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sim_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     Ü     ┃     '     ┃     "     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   å / Å   ┃           ┃     SZ    ┃     `     ┃     ?     ┃   ┃    MUTE   ┃   YEN ¥   ┃   EURO €  ┃  POUND £  ┃   ö / Ö   ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
